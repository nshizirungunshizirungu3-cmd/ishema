{
    "name": "ishema/hotel-restaurant-management",
    "description": "ISHEMA - Multi-tenant Hotel & Restaurant Management SaaS Platform",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.2",
        "ext-pdo_mysql": "*",
        "ext-mbstring": "*",
        "ext-gd": "*",
        "ext-curl": "*",
        "ext-openssl": "*"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        },
        "classmap": [
            "app/Models/",
            "app/Middleware/"
        ]
    },
    "config": {
        "optimize-autoloader": true
    }
}
