# ISHEMA - Hotel & Restaurant Management System
# Copy this file to ".env" and fill in your values.

APP_NAME=ISHEMA
APP_URL=http://localhost/ishema/public
APP_ENV=local
APP_DEBUG=true
APP_TIMEZONE=Africa/Kigali

# MySQL (XAMPP defaults shown)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=ishema_system
DB_USER=root
DB_PASS=

# Super admin bootstrap account (used by install.php only)
SUPER_ADMIN_NAME=Super Administrator
SUPER_ADMIN_EMAIL=admin@ishema.com
SUPER_ADMIN_PASSWORD=ChangeMe123!

# Payment gateway credentials (fill with real provider keys when integrating)
MTN_API_KEY=
MTN_API_USER=
MTN_API_ENV=sandbox
AIRTEL_API_KEY=
AIRTEL_API_USER=
AIRTEL_API_ENV=sandbox
